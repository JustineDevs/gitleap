# Copy to .env for local development. Never commit real credentials.

# Server
DATABASE_URL=postgresql://gitleap:gitleap@localhost:55432/gitleap
BETTER_AUTH_SECRET=replace-with-at-least-32-random-characters
BETTER_AUTH_URL=http://localhost:3000
CORS_ORIGIN=http://localhost:5173
STRIPE_SECRET_KEY=sk_test_replace_me
STRIPE_WEBHOOK_SECRET=whsec_replace_me
ARCJET_KEY=ajkey_replace_me
NODE_ENV=development

# Browser and CLI clients
VITE_SERVER_URL=http://localhost:3000
GITLEAP_SERVER_URL=http://localhost:3000

# Processing model. Set all three together, or leave empty to use the explicit
# development-only baseline compiler.
MODEL_API_URL=
MODEL_API_KEY=
MODEL_NAME=
ALLOW_BASELINE_COMPILER=true

# Private Supabase Storage for generated artifacts
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=replace-me
SUPABASE_STORAGE_BUCKET=gitleap-artifacts

# BullMQ / Redis
REDIS_URL=redis://localhost:56379

# Processing budgets
PROCESSING_MAX_COST_USD=2
PROCESSING_MAX_CALL_COST_USD=0.25

# OpenTelemetry / SigNoz
OTEL_SERVICE_NAME=gitleap-server
OTEL_SERVICE_VERSION=1.0.0
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
OTEL_EXPORTER_OTLP_HEADERS=
