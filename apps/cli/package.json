{
  "name": "gitleap-cli",
  "version": "0.1.0",
  "description": "GitLeap command-line client",
  "type": "module",
  "bin": {
    "gitleap": "dist/index.js"
  },
  "scripts": {
    "dev": "bun src/index.ts",
    "build": "bun build src/index.ts --outdir dist --target bun --external '@opentui/core-*'",
    "compile": "bun build --compile --minify src/index.ts --outfile dist/gitleap --external '@opentui/core-*'",
    "check-types": "tsc --noEmit",
    "test": "bun test src"
  },
  "engines": {
    "bun": ">=1.3.0"
  },
  "dependencies": {
    "@gitleap/design": "workspace:*",
    "@opentui/core": "^0.4.5"
  },
  "devDependencies": {
    "@types/bun": "catalog:",
    "typescript": "^6.0.3"
  }
}
