# Package-scoped server example. Root-launched commands should use the
# repository-root .env.example instead.
# Required server configuration
DATABASE_URL=postgresql://postgres:password@localhost:5432/postgres
BETTER_AUTH_SECRET=replace-with-at-least-32-random-characters
BETTER_AUTH_URL=http://localhost:3000
CORS_ORIGIN=http://localhost:5173
STRIPE_SECRET_KEY=sk_test_replace_me
STRIPE_WEBHOOK_SECRET=whsec_replace_me
ARCJET_KEY=ajkey_replace_me

# Processing model. All three values must be set together, or leave all empty
# to use the explicitly opt-in local baseline compiler during development.
MODEL_API_URL=
MODEL_API_KEY=
MODEL_NAME=
ALLOW_BASELINE_COMPILER=true

# Private Supabase Storage used for generated artifacts
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=replace-me
SUPABASE_STORAGE_BUCKET=gitleap-artifacts

# BullMQ / Redis. Use REDIS_URL, or configure the host/port/password variables
# consumed by the local Redis adapter.
REDIS_URL=redis://localhost:6379
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# Processing budgets
PROCESSING_MAX_COST_USD=2
PROCESSING_MAX_CALL_COST_USD=0.25
NODE_ENV=development

# OpenTelemetry / SigNoz
OTEL_SERVICE_NAME=gitleap-server
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
OTEL_EXPORTER_OTLP_HEADERS=
