{
  "name": "gitleap",
  "private": true,
  "workspaces": {
    "packages": [
      "apps/*",
      "packages/*"
    ],
    "catalog": {
      "dotenv": "^17.4.2",
      "zod": "^4.4.3",
      "@types/bun": "^1.3.14",
      "hono": "^4.12.27",
      "@trpc/server": "^11.18.0",
      "better-auth": "^1.6.22",
      "stripe": "^22.4.0",
      "vitest": "4.1.8",
      "@vitest/ui": "4.1.8",
      "@vitest/coverage-v8": "4.1.8",
      "jsdom": "^29.1.1",
      "react": "^19.2.8",
      "react-dom": "^19.2.8",
      "@prisma/client": "^7.9.1",
      "@trpc/client": "^11.18.0",
      "@types/node": "^26.2.0",
      "@types/react": "^19.2.18",
      "@types/react-dom": "^19.2.4",
      "postcss": "^8.5.15",
      "tailwindcss": "^4.3.3"
    }
  },
  "type": "module",
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "check-types": "turbo check-types",
    "dev:web": "turbo -F web dev",
    "dev:docs": "turbo -F fumadocs dev",
    "dev:cli": "bun --cwd apps/cli dev",
    "build:cli": "bun --cwd apps/cli build",
    "compile:cli": "bun --cwd apps/cli compile",
    "test:cli": "bun --cwd apps/cli test",
    "build:docs": "turbo -F fumadocs build",
    "check:docs": "turbo -F fumadocs check-types",
    "dev:server": "turbo -F server dev",
    "db:push": "turbo -F @gitleap/db db:push",
    "db:studio": "turbo -F @gitleap/db db:studio",
    "db:generate": "turbo -F @gitleap/db db:generate",
    "db:migrate": "turbo -F @gitleap/db db:migrate",
    "test": "bun run --filter server test && bun run --filter web test && bun run --filter @gitleap/api test && bun run --filter gitleap-cli test && bun run --filter @gitleap/design test && bun run --filter @gitleap/oss-integrations test",
    "test:infra:up": "docker compose -f infra/docker-compose.test.yml up -d --wait",
    "test:infra:migrate": "DATABASE_URL=postgresql://gitleap:gitleap@localhost:55432/gitleap bunx --bun prisma migrate deploy --config packages/db/prisma.config.ts",
    "test:infra:upgrade": "sh infra/verify-migration-upgrade.sh",
    "test:infra:down": "docker compose -f infra/docker-compose.test.yml down -v",
    "test:infra:verify": "sh infra/verify-db-invariants.sh",
    "test:infra:recovery": "DATABASE_URL=postgresql://gitleap:gitleap@localhost:55432/gitleap bun --cwd apps/server src/processing/recovery-smoke.ts",
    "test:infra:race": "DATABASE_URL=postgresql://gitleap:gitleap@localhost:55432/gitleap bun --cwd apps/server src/processing/race-smoke.ts",
    "test:infra:quota": "DATABASE_URL=postgresql://gitleap:gitleap@localhost:55432/gitleap bun --cwd apps/server src/processing/quota-smoke.ts",
    "test:infra:queue": "DATABASE_URL=postgresql://gitleap:gitleap@localhost:55432/gitleap REDIS_URL=redis://localhost:56379 bun --cwd apps/server src/processing/queue-smoke.ts",
    "test:infra:cleanup": "DATABASE_URL=postgresql://gitleap:gitleap@localhost:55432/gitleap bun --cwd apps/server src/processing/cleanup-smoke.ts",
    "test:infra:pipeline": "DATABASE_URL=postgresql://gitleap:gitleap@localhost:55432/gitleap bun --cwd apps/server src/processing/pipeline-smoke.ts",
    "test:load": "DATABASE_URL=postgresql://gitleap:gitleap@localhost:55432/gitleap REDIS_URL=redis://localhost:56379 bun --cwd apps/server src/processing/load-smoke.ts",
    "smoke:github": "bun scripts/smoke-github.ts",
    "smoke:otel": "bun --cwd apps/server src/lib/tracing-smoke.ts",
    "smoke:supabase": "bun scripts/smoke-supabase.ts",
    "smoke:processing": "DATABASE_URL=postgresql://gitleap:gitleap@localhost:55432/gitleap SUPABASE_URL=https://example.supabase.co SUPABASE_SERVICE_ROLE_KEY=smoke-service-role SUPABASE_STORAGE_BUCKET=private CORS_ORIGIN=http://localhost:3000 BETTER_AUTH_SECRET=test-secret-test-secret-test-secret BETTER_AUTH_URL=http://localhost:3000 STRIPE_SECRET_KEY=smoke-stripe STRIPE_WEBHOOK_SECRET=smoke-webhook ARCJET_KEY=smoke-arcjet bun --cwd apps/server src/processing/processing-smoke.ts",
    "smoke:http-lifecycle": "ARCJET_ENV=development DATABASE_URL=postgresql://gitleap:gitleap@localhost:55432/gitleap SUPABASE_URL=https://example.supabase.co SUPABASE_SERVICE_ROLE_KEY=smoke-service-role SUPABASE_STORAGE_BUCKET=private CORS_ORIGIN=http://localhost:3000 BETTER_AUTH_SECRET=test-secret-test-secret-test-secret BETTER_AUTH_URL=http://localhost:3000 STRIPE_SECRET_KEY=smoke-stripe STRIPE_WEBHOOK_SECRET=smoke-webhook ARCJET_KEY=smoke-arcjet ALLOW_BASELINE_COMPILER=true bun --cwd apps/server src/processing/http-lifecycle-smoke.ts",
    "lint": "node scripts/lint-node20.mjs check",
    "format": "ultracite fix",
    "lint:doctor": "ultracite doctor",
    "knip": "knip",
    "knip:production": "knip --production --include files,dependencies,binaries",
    "secrets:scan": "gitleaks git --config .gitleaks.toml --redact --verbose",
    "secrets:scan:staged": "gitleaks git --config .gitleaks.toml --pre-commit --redact --staged --verbose",
    "check:execution-boundary": "bun scripts/check-execution-boundary.ts",
    "ruler:apply": "bunx @intellectronica/ruler@latest apply --local-only",
    "oss:repomix": "bun packages/oss-integrations/src/cli.ts repomix",
    "oss:install": "bun packages/oss-integrations/src/cli.ts install",
    "oss:prompt": "bun packages/oss-integrations/src/cli.ts prompt"
  },
  "dependencies": {},
  "devDependencies": {
    "@biomejs/biome": "^2.5.7",
    "@gitleap/config": "workspace:*",
    "@types/bun": "catalog:",
    "knip": "^6.32.0",
    "server": "workspace:*",
    "tsdown": "0.19.0",
    "turbo": "^2.10.0",
    "typescript": "^6.0.3",
    "ultracite": "^7.10.1",
    "unrun": "^0.3.1",
    "vercel": "^54.18.2"
  },
  "overrides": {
    "kysely": "0.28.17"
  },
  "packageManager": "bun@1.3.14"
}
