{
  "name": "@gitleap/db",
  "type": "module",
  "exports": {
    ".": {
      "default": "./src/index.ts"
    },
    "./*": {
      "default": "./src/*.ts"
    }
  },
  "scripts": {
    "check-types": "tsc --noEmit --declaration false --declarationMap false --composite false",
    "postinstall": "prisma generate",
    "db:push": "prisma db push",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:studio": "prisma studio"
  },
  "dependencies": {
    "@gitleap/env": "workspace:*",
    "@prisma/adapter-pg": "^7.9.1",
    "@prisma/client": "catalog:",
    "dotenv": "catalog:",
    "pg": "^8.22.0",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@gitleap/config": "workspace:*",
    "@types/pg": "^8.21.0",
    "prisma": "^7.9.1",
    "typescript": "^6.0.3"
  }
}
